<%= render "shared/header" %>

<h3>設定</h3>

<ul>
  <li><%= link_to "アカウント", users_account_path %></li>
  <li><%= link_to "プロフィール", users_profile_path %></li>
</ul>

<ul>
  <li>プロフィール</li>
  <li><%= link_to "編集", users_profile_edit_path %></li>
</ul>

<table>
  <tr>
    <th>アイコン画像</th>
    <td>
      <% if current_user.user_icon.present? %>
        <%= image_tag current_user.user_icon, size: "100x100" %>
      <% else %>
        <%= image_tag "https://rails-02-sample.herokuapp.com/assets/common/default-avatar-7a6cbfd7993e89f24bfc888f4a035a83c6f1428b8bdc47eed9095f2799a40153.png", size: "100x100" %>
      <% end %>
    </td>
  </tr>
  <tr>
    <th>名前</th>
    <td><%= @user.name %></td>
  </tr>
  <tr>
    <th>自己紹介</th>
    <td><%= @user.introduce %></td>
  </tr>
</table>