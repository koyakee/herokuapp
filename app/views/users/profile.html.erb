<%= render "shared/header" %>

<h3>設定</h3>

<ul>
  <li><%= link_to "アカウント", users_account_path %></li>
  <li><%= link_to "プロフィール", users_profile_path %></li>
</ul>

<ul>
  <li>プロフィール</li>
  <li><%= link_to "編集", users_profile_edit_path %></li>
</ul>

<table>
  <tr>
    <th>アイコン画像</th>
    <td><%= image_tag @user.user_icon if @user.user_icon.present? %></td>
  </tr>
  <tr>
    <th>名前</th>
    <td><%= @user.name %></td>
  </tr>
  <tr>
    <th>自己紹介</th>
    <td><%= @user.introduce %></td>
  </tr>
</table>