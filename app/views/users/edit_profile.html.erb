<%= render "shared/header" %>

<h3>設定</h3>
<ul>
  <li>プロフィール</li>
</ul>

<ul>
  <li><%= link_to "アカウント", users_account_path %></li>
  <li><%= link_to "プロフィール", users_profile_path %></li>
</ul>

<%= form_with model: @user, url: users_profile_path, method: :patch do |f| %>
  <table>
    <tr>
      <th><%= f.label :user_icon ,"アイコン画像" %></th>
      <td><%= f.file_field :user_icon %></td>
    </tr>
    <tr>
      <th><%= f.label :name ,"名前" %></th>
      <td><%= f.text_field :name %></td>
    </tr>
    <tr>
      <th><%= f.label :introduce ,"自己紹介" %></th>
      <td><%= f.text_field :introduce %></td>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "保存" %></li>
      <li><%= link_to "キャンセル", :back %></li>
    </ul>
  </div>
<% end %>