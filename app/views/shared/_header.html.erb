<header>
  <nav class="headerNav">
    <div class="headerContainer">
      <a class="headerLogo" href="/">
        <img class="headerLogoImage" src="https://rails-02-sample.herokuapp.com/assets/common/logo.png" alt="Potepan Share">
      </a>
      <% if user_signed_in? %>
        <div class="dropdown">
          <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <%= image_tag current_user.user_icon if current_user.user_icon.present? %>
            <%= current_user.name %>
          </button>
          <ul class="dropdown-menu">
            <li><%= link_to "アカウント設定", users_account_path, class: "dropdown-item" %></li>
            <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
          </ul>
        </div>
      <% else %>
        <ul class="nav">
          <li><%= link_to "ログイン", new_user_session_path, class: "nav-link" %></li>
          <li><%= link_to "新規登録", new_user_registration_path, class: "nav-link" %></li>
        </ul>
      <% end %>
    </div>
  </nav>
</header>
  