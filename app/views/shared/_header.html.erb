<header>
  <nav class="headerNav">
    <div class="headerContainer">
      <a class="headerLogo" href="/">
        <img class="headerLogoImage" src="https://rails-02-sample.herokuapp.com/assets/common/logo.png" alt="Potepan Share">
      </a>
      <% if user_signed_in? %>
        <div class="dropdown">
          <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <% if current_user.user_icon.present? %>
              <%= image_tag current_user.user_icon, size: "100x100" %>
            <% else %>
              <%= image_tag "https://rails-02-sample.herokuapp.com/assets/common/default-avatar-7a6cbfd7993e89f24bfc888f4a035a83c6f1428b8bdc47eed9095f2799a40153.png", size: "100x100" %>
            <% end %>
            <%= current_user.name %>
          </button>
          <ul class="dropdown-menu">
            <li><%= link_to "施設の新規登録", new_room_path, class: "dropdown-item" %></li>
            <li><%= link_to "予約済み一覧", reservations_path, class: "dropdown-item" %></li>
            <li><%= link_to "登録済み一覧", own_rooms_path, class: "dropdown-item" %></li>
            <li><%= link_to "アカウント設定", users_account_path, class: "dropdown-item" %></li>
            <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
          </ul>
        </div>
      <% else %>
        <ul class="nav">
          <li><%= link_to "ログイン", new_user_session_path, class: "nav-link" %></li>
          <li><%= link_to "新規登録", new_user_registration_path, class: "nav-link" %></li>
        </ul>
      <% end %>
    </div>
  </nav>
</header>