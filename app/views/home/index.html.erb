<%= render "shared/header" %>

<div class="FirstView">
  <div class="Container">
    <h2 class="FirstViewTitle">Potepan Shareで<br>まだ体験したことのない<br>旅をしよう</h2>
    <div class="SearchForm">
    <%= form_with url: rooms_path, method: :get, local: true do |form| %>
      <div>
        <%= form.text_field :facility_address, placeholder: "エリア名を入力" %>
        <%= form.submit "検索" %>
      </div>
    <% end %>
    
    </div>
  </div>
</div>
<div class="AreaWrapper">
  <div class="AreaContainer">
    <h2>おすすめのエリア</h2>
    <div class="RecommendAreas">
      <%= link_to "東京", rooms_path(facility_address: "東京") %>
      <%= link_to "大阪", rooms_path(facility_address: "大阪") %>
      <%= link_to "京都", rooms_path(facility_address: "京都") %>
      <%= link_to "札幌", rooms_path(facility_address: "札幌") %>
    </div>
  </div>
</div>