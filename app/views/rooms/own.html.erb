<%= render "shared/header" %>

<h3>登録済み一覧</h3>

<table>
  <thead>
    <tr>
      <th></th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>料金</th>
      <th>作成日</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td>
          <% if room.facility_images.attached? %>
            <%= image_tag room.facility_images, size: "100x100" %>
          <% else %>
            <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", size: "100x100" %>
          <% end %>
        </td>
        <td><%= link_to room.facility_name, room_path(room) %></td>
        <td><%= room.facility_details %></td>
        <td>¥<%= room.facility_fee %>（/日）</td>
        <td><%= room.created_at.strftime("%Y/%m/%d") %></td>
        <td><%= link_to "施設を編集", edit_room_path(room) %></td>
        <td><%= link_to "施設を削除", room, method: :delete %></td>
      </tr>
    <% end %>
  </tbody>
</table>

