<%= render "shared/header" %>

<h3>登録済み一覧</h3>

<table>
  <thead>
    <tr>
      <th>画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>料金</th>
      <th>作成日</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td><%= room.facility_images %></td>
        <td><%= link_to room.facility_name, room_path(room) %></td>
        <td><%= room.facility_details %></td>
        <td><%= room.facility_fee %></td>
        <td><%= room.created_at.to_s(:datetime_jp) %></td>
        <td><%= link_to "施設を編集", edit_room_path(room) %></td>
        <td><%= link_to "施設を削除", room, method: :delete %></td>
      </tr>
    <% end %>
  </tbody>
</table>

