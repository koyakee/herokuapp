<%= render "shared/header" %>

<% if flash[:success] %>
  <p><%= flash[:success] %></p>
<% end %>

<%= form_with url: rooms_path, method: :get, local: true do |form| %>
  <div>
    <%= form.text_field :facility_address, placeholder: "エリア名を入力" %>
    <%= form.text_field :search_keyword, placeholder: "キーワード名を入力" %>
    <%= form.submit "検索" %>
  </div>
<% end %>


<h2><span><%= @rooms.count %></span>件見つかりました</h2>
<table>  
  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td>
          <% if room.facility_images.attached? %>
            <%= image_tag room.facility_images, size: "100x100" %>
          <% else %>
            画像なし
          <% end %>
        </td>
        <td><%= link_to room.facility_name, room_path(room) %></td>
        <td><%= room.facility_address %></td>
        <td><%= room.facility_details %></td>
        <td><%= room.facility_fee %></td>
      </tr>
    <% end %>
  </tbody>
</table>
